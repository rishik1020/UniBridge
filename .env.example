# Supabase configuration
# Copy this file to `.env` and fill in your own Supabase project's values.
# `.env` is gitignored and must never be committed.
#
# The publishable/anon key below is safe to expose in the browser (it is gated by
# Row Level Security). NEVER put your service_role key in this file or the frontend.

VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
